def insertion_sort(arr):
    n = len(arr)
    # 첫 번째 요소는 이미 정렬됐다고 생각
    # 두 번째 요소부터 시작
    for i in range(1, n):
        # 현재 요소로부터 왼쪽으로 이동하면서 비교를 시작
        for j in range(i, 0, -1):
            if arr[j-1] > arr[j]:
                arr[j-1], arr[j] = arr[j], arr[j-1]
            # 왼쪽 값이 현재 요소보다 같거나 작으면 => break
            else:
                break
    print(arr)


arr = [69, 10, 30, 2, 16, 31, 22]
insertion_sort(arr)

